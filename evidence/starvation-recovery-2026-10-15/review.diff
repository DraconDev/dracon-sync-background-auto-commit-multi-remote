+            collect_ready_status(
+                &mut jobs,
+                &mut pending,
+                &mut aborts,
+                &mut since,
+                &mut results,
+            );
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(dropped.load(Ordering::SeqCst));
+    assert!(pending.is_empty());
+    assert!(aborts.is_empty());
+    assert!(jobs.is_empty());
+    assert!(results
+        .remove(&hung)
+        .unwrap()
+        .0
+        .unwrap_err()
+        .downcast_ref::<tokio::task::JoinError>()
+        .unwrap()
+        .is_cancelled());
+}
