+struct ProbeOwner {
+    abort: tokio::task::AbortHandle,
+    cancelling: bool,
+}
+
+impl From<tokio::task::AbortHandle> for ProbeOwner {
+    fn from(abort: tokio::task::AbortHandle) -> Self {
+        Self {
+            abort,
+            cancelling: false,
+        }
+    }
+}
+
+impl ProbeOwner {
+    fn request_cancellation(&mut self) -> bool {
+        if self.cancelling {
+            return false;
+        }
+        self.cancelling = true;
+        self.abort.abort();
+        true
+    }
+}
