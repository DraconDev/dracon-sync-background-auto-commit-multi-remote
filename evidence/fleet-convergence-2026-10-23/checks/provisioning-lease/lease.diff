+async function provisioningLease(record, log) {
+  // Mirrors may transfer independently, but simultaneous full workspace
+  // installs can exhaust the service's shared task budget even with bounded
+  // native pools. Serialize only this repository's preparation, not its
+  // product gates, commits, transfers, or other repositories.
+  const common = git(original, ['rev-parse', '--path-format=absolute', '--git-common-dir']);
+  const scope = hash(common);
+  const fd = openSync(join(root, `provision-${scope}.lock`),
+    constants.O_RDWR | constants.O_CREAT | constants.O_NOFOLLOW, 0o600);
+  let output;
+  try {
+    const stat = fstatSync(fd);
+    if (!stat.isFile() || stat.nlink !== 1 || (stat.mode & 0o077) !== 0 ||
+        (process.geteuid && stat.uid !== process.geteuid())) throw Error('unsafe provisioning lease file');
+    record.provisioning = { scope, status: 'waiting', waitBudgetSecs: 300, started: new Date().toISOString() };
+    receipt();
+    output = openSync(log, 'a', 0o600);
+    const code = await new Promise((done, reject) => {
+      // fd3 shares the parent's open-file description; the acquired OS lease
+      // remains held after flock exits, until our finally closes fd.
+      const child = spawn('flock', ['--exclusive', '--wait', '300', '--conflict-exit-code', '75', '3'],
+        { env, stdio: ['ignore', output, output, fd] });
+      child.once('error', reject); child.once('close', code => done(code ?? 128));
+    });
+    if (code) throw Error(`snapshot provisioning capacity wait expired or failed (exit ${code}); no dependency/product pass claimed`);
+    record.provisioning.status = 'owned'; record.provisioning.acquired = new Date().toISOString(); receipt();
+    return fd;
+  } catch (error) {
+    closeSync(fd);
+    if (record.provisioning) { record.provisioning.status = 'failed'; receipt(); }
+    throw error;
+  } finally { if (output !== undefined) closeSync(output); }
