     assert.equal(result.manifest.revisions[0].gates[0].status, 'passed');
   } finally { rmSync(repo.root, { recursive: true, force: true }); }
 });
+
+for (const stricter of [false, true]) test(`native pool budgets ${stricter ? 'preserve stricter caller limits' : 'bound lifecycle, library and gate workers'}`, async () => {
+  const repo = fixture();
+  const limits = { TOKIO_WORKER_THREADS: 2, RAYON_NUM_THREADS: 2, ROLLDOWN_WORKER_THREADS: 2,
+    ROLLDOWN_MAX_BLOCKING_THREADS: 8, GOMAXPROCS: 2 };
+  try {
+    repo.put('package.json', JSON.stringify({ packageManager: 'bun@1.3.14',
+      workspaces: ['packages/*', 'extensions/standalones/*'] }));
+    repo.put('check-pools.mjs', `import assert from 'node:assert/strict';
+import {appendFileSync} from 'node:fs';
+for (const [key, limit] of Object.entries(${JSON.stringify(limits)}))
+  assert.equal(process.env[key], process.env.STRICTER_POOLS === 'yes' ? '1' : String(limit), key);
+appendFileSync(process.env.POOL_TRACE, process.argv[2] + '\\n');`);
+    repo.put('packages/runtime/package.json', JSON.stringify({ name: '@fixture/runtime', version: '1.0.0',
+      main: './dist/index.js', scripts: { build: 'node ../../check-pools.mjs library && node build.mjs' } }));
+    repo.put('packages/runtime/build.mjs', `import {mkdirSync,writeFileSync} from 'node:fs';
+mkdirSync('dist',{recursive:true});writeFileSync('dist/index.js','export const ok=1;');`);
+    const check = 'node ../../../check-pools.mjs';
+    repo.put(`${ws}/package.json`, JSON.stringify({ name: 'fixture-pools', version: '1.0.0',
+      dependencies: { '@fixture/runtime': 'workspace:*' }, scripts: { postinstall: `${check} install`,
+        pretest: `${check} pretest`, test: `${check} test`, posttest: `${check} posttest` } }));
+    execFileSync('bun', ['install', '--ignore-scripts'], { cwd: repo.root, stdio: 'ignore' });
+    repo.sha = repo.commit();
+    const trace = join(repo.root, 'attempts', 'pool-phases.log');
+    const extra = { ...Object.fromEntries(Object.keys(limits).map(key => [key, stricter ? '1' : '999'])),
+      STRICTER_POOLS: stricter ? 'yes' : 'no', POOL_TRACE: trace };
+    const result = await run(repo, undefined, extra);
+    assert.equal(result.code, 0, result.output);
+    assert.deepEqual(result.manifest.resourceEnvironment,
+      Object.fromEntries(Object.entries(limits).map(([key, limit]) => [key, String(stricter ? 1 : limit)])));
+    const phases = readFileSync(trace, 'utf8').trim().split('\n');
+    for (const phase of ['library', 'install', 'pretest', 'test', 'posttest']) assert.ok(phases.includes(phase), phase);
+  } finally { rmSync(repo.root, { recursive: true, force: true }); }
+});
