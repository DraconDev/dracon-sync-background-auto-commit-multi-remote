diff --git a/scripts/git-hooks/run-push-gates.mjs b/scripts/git-hooks/run-push-gates.mjs
index 7e37b2baf7..20f15f308e 100644
--- a/scripts/git-hooks/run-push-gates.mjs
+++ b/scripts/git-hooks/run-push-gates.mjs
@@ -11,6 +11,17 @@ import { fileURLToPath } from 'node:url';
 process.umask(0o077);
 const original = realpathSync(process.cwd());
 const env = { ...process.env };
+// Each mirror owns an independent hook, but they share the daemon's finite
+// task budget. Native pools also run during install/prepare, before Vitest's
+// cap applies. Bound their fan-out without serializing publication or skipping
+// lifecycle scripts; retain caller limits that are already stricter.
+const resourceEnvironment = {};
+for (const [key, limit] of Object.entries({ TOKIO_WORKER_THREADS: 2, RAYON_NUM_THREADS: 2,
+  ROLLDOWN_WORKER_THREADS: 2, ROLLDOWN_MAX_BLOCKING_THREADS: 8, GOMAXPROCS: 2 })) {
+  const requested = Number(env[key]);
+  env[key] = String(Number.isInteger(requested) && requested > 0 ? Math.min(requested, limit) : limit);
+  resourceEnvironment[key] = env[key];
+}
 // Git's push environment must not redirect snapshot commands into the live index.
 for (const key of ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_COMMON_DIR', 'GIT_INDEX_FILE',
   'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_PREFIX']) delete env[key];
@@ -24,7 +35,7 @@ console.log(`🧾 Pre-push attempt logs: ${attempt}`);
 env.npm_config_cache = join(root, 'npm-cache');
 env.BUN_INSTALL_CACHE_DIR = join(root, 'bun-cache');
 const manifest = { version: 1, repo: original, runnerSha256: hash(readFileSync(fileURLToPath(import.meta.url))),
-  started: new Date().toISOString(), ownerPid: process.pid, tuples: [], revisions: [], status: 'running' };
+  resourceEnvironment, started: new Date().toISOString(), ownerPid: process.pid, tuples: [], revisions: [], status: 'running' };
 const receipt = () => writeFileSync(join(attempt, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
 receipt();
 let activeTree;
