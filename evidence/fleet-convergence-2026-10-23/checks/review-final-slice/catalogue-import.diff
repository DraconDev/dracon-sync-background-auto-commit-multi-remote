@@ -0,0 +1,17 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import { listOpenRouterModels } from '../../src/byok/catalogue.js';
+
+// A missing endpoint import used to be swallowed as an empty catalogue, while
+// also refusing the clean-snapshot library build. No provider request is made.
+afterEach(() => vi.unstubAllGlobals());
+
+it('fetches the shared OpenRouter endpoint instead of hiding a local reference error', async () => {
+  const fetchMock = vi.fn().mockResolvedValue(new Response(JSON.stringify({ data: [
+    { id: 'fixture-model', name: 'Fixture Model', pricing: { prompt: '0', completion: '0' }, context_length: 8192 },
+  ] }), { status: 200 }));
+  vi.stubGlobal('fetch', fetchMock);
+  const models = await listOpenRouterModels();
+  expect(models).toEqual([{ id: 'fixture-model', name: 'Fixture Model', free: true, context_length: 8192 }]);
+  expect(fetchMock).toHaveBeenCalledWith('https://openrouter.ai/api/v1/models',
+    expect.objectContaining({ signal: expect.anything() }));
+});
