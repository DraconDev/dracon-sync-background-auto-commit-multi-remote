@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { cp, mkdtemp, rm, symlink, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+// A warm dist masks package self-imports when the publisher overrides outDir.
+// Compile real source without old outputs; never recursively invoke a test suite.
+test('forms builds cold, tolerates an unrelated source addition and rejects a dist self-dependency',
+  { timeout: 60000 }, async () => {
+    const source = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+    const root = await mkdtemp(join(tmpdir(), 'forms-cold-build-'));
+    const build = () => spawnSync(process.execPath,
+      [resolve(source, '../../scripts/build-library.mjs')],
+      { cwd: root, encoding: 'utf8', timeout: 15000 });
+    try {
+      await cp(join(source, 'src'), join(root, 'src'), { recursive: true });
+      for (const name of ['package.json', 'tsconfig.json']) await cp(join(source, name), join(root, name));
+      await symlink(join(source, 'node_modules'), join(root, 'node_modules'), 'dir');
+      let result = build();
+      assert.equal(result.status, 0, result.stdout + result.stderr);
+      await rm(join(root, 'dist'), { recursive: true });
+      await writeFile(join(root, 'src/harmless.ts'), 'export const harmless = 1;\n');
+      result = build();
+      assert.equal(result.status, 0, result.stdout + result.stderr);
+      await rm(join(root, 'dist'), { recursive: true });
+      await writeFile(join(root, 'src/counterexample.ts'),
+        "import type { FormFieldData } from '@dracon/extension-forms';\nexport type Counterexample = FormFieldData;\n");
+      result = build();
+      assert.notEqual(result.status, 0);
+      assert.match(result.stdout + result.stderr, /Cannot find module '@dracon\/extension-forms'/);
+    } finally { await rm(root, { recursive: true, force: true }); }
+  });
