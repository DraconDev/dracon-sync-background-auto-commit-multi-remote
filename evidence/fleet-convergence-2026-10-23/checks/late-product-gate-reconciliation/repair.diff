diff --git a/extensions/standalones/vidpro-extension/e2e/publishing-row-layout.spec.ts b/extensions/standalones/vidpro-extension/e2e/publishing-row-layout.spec.ts
new file mode 100644
index 0000000000..eea85012b0
--- /dev/null
+++ b/extensions/standalones/vidpro-extension/e2e/publishing-row-layout.spec.ts
@@ -0,0 +1,36 @@
+import { test, expect } from "@playwright/test";
+import { createExtensionContext } from "./extensionHelpers";
+
+test("publishing control edges align and an actual vertical offset is detected", async () => {
+  // This is a local built-extension check. The qualification command unsets
+  // VIDPRO_LIVE_USER_DATA_DIR so no signed-in operator profile is involved.
+  const { context, extensionId } = await createExtensionContext();
+  try {
+    await context.route(/^https?:\/\//, (route) => route.fulfill({
+      status: 200, contentType: "application/json", body: "{}",
+    }));
+    const page = await context.newPage();
+    await page.setViewportSize({ width: 1920, height: 1080 });
+    await page.goto(`chrome-extension://${extensionId}/dashboard.html?tab=settings`);
+    const category = page.getByLabel("Category", { exact: true });
+    const kidsBox = page.getByTestId("kids-state").locator("..");
+    await expect(category).toBeVisible();
+    await expect(kidsBox).toBeVisible();
+    const difference = async () => {
+      const [select, box] = await Promise.all([category.boundingBox(), kidsBox.boundingBox()]);
+      if (!select || !box) throw new Error("publishing control geometry unavailable");
+      return Math.abs(select.y - box.y);
+    };
+    // A desktop two-column row must share a control top edge. One CSS pixel
+    // permits subpixel rounding, not the former visibly offset card layout.
+    expect(await difference()).toBeLessThanOrEqual(1);
+    await kidsBox.evaluate((box) => box.classList.add("harmless-layout-wrapper-name"));
+    expect(await difference()).toBeLessThanOrEqual(1);
+    // A disposable DOM mutation proves the metric detects real misalignment;
+    // no source, stored settings or actual user data is changed.
+    await kidsBox.evaluate((box) => { box.style.marginTop = "24px"; });
+    expect(await difference()).toBeGreaterThan(1);
+  } finally {
+    await context.close();
+  }
+});

