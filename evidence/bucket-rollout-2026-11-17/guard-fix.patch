+import { afterEach, expect, test } from 'bun:test';
+import { randomBytes } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, writeFileSync, rmSync, readFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import * as strategy from './bucket-strategy-core.mjs';
+const measure = strategy.measureOutgoingPush ?? strategy.measurePushableBranch;
+const roots = [];
+const github = 'git@github.com:example/guard.git';
+const gitlab = 'git@gitlab.com:example/guard.git';
+const policy = {
+  schemaVersion: 1,
+  buckets: { games: { name: 'dracon-games', endpoint: 'https://s3.uk.io.cloud.ovh.net/', publicBaseUrl: 'https://dracon-games.s3.uk.io.cloud.ovh.net' } },
+  namespaces: { games: 'games' },
+  providerLimits: { github: { bytes: 128 * 1024 }, gitlab: { bytes: 128 * 1024 } },
+  guard: { failClosed: true, mode: 'pushable-branch', blockAtOrAbove: true }
+};
+function git(root, ...args) {
+  return execFileSync('git', ['-c', 'core.hooksPath=/dev/null', '-C', root, ...args], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
+}
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'outgoing-limit-')); roots.push(root);
+  git(root, '-c', 'init.templateDir=', 'init', '-q', '-b', 'main');
+  git(root, 'config', 'user.name', 'Sizing Fixture'); git(root, 'config', 'user.email', 'sizing@example.invalid');
+  writeFileSync(join(root, 'art.bin'), randomBytes(256 * 1024));
+  git(root, 'add', '--', 'art.bin'); git(root, 'commit', '-qm', 'published art baseline');
+  const base = git(root, 'rev-parse', 'HEAD');
+  git(root, 'remote', 'add', 'origin', github); git(root, 'update-ref', 'refs/remotes/origin/main', base);
+  writeFileSync(join(root, 'README.md'), 'ordinary code change\n');
+  git(root, 'add', '--', 'README.md'); git(root, 'commit', '-qm', 'small change');
+  return { root, base };
+}
+afterEach(() => { while (roots.length) rmSync(roots.pop(), { recursive: true, force: true }); });
+test('ordinary increment passes while repository storage remains above the transfer limit', async () => {
+  const { root } = fixture();
+  const storage = await strategy.measurePushableBranch(root, policy);
+  expect(strategy.evaluateHighWater(storage).ok).toBe(false);
+  const outgoing = await measure(root, policy);
+  expect(strategy.evaluateHighWater(outgoing).ok).toBe(true);
+  expect(outgoing.projectedBytes).toBeLessThan(128 * 1024);
+});
+test('a new mirror still measures the complete requested history', async () => {
+  const { root } = fixture(); git(root, 'remote', 'add', 'gitlab', gitlab);
+  const result = await measure(root, policy);
+  expect(strategy.evaluateHighWater(result).ok).toBe(false);
+  expect(result.scenarios.find(r => r.remote === 'origin').basisBytes).toBeLessThan(128 * 1024);
+  expect(result.scenarios.find(r => r.remote === 'gitlab').basisBytes).toBeGreaterThan(256 * 1024);
+});
+test('an advertised new ref overrides a cached tracking tip', async () => {
+  const { root } = fixture(); const head = git(root, 'rev-parse', 'HEAD');
+  const result = await measure(root, policy, { refs: [{ localRef: 'refs/heads/main', localOid: head, remoteTip: '0'.repeat(40) }], targetRemoteName: 'origin', targetRemoteUrl: github });
+  expect(strategy.evaluateHighWater(result).ok).toBe(false);
+});
+test('unrelated local refs do not become bytes in a main-only push', async () => {
+  const { root } = fixture();
+  git(root, 'checkout', '--orphan', 'local-archive'); git(root, 'rm', '-rf', '.');
+  writeFileSync(join(root, 'archive.bin'), randomBytes(512 * 1024));
+  git(root, 'add', '--', 'archive.bin'); git(root, 'commit', '-qm', 'local-only archive'); git(root, 'checkout', 'main');
+  expect(strategy.evaluateHighWater(await measure(root, policy)).ok).toBe(true);
+});
+test('same-URL aliases share evidence but another repository cannot borrow it', async () => {
+  const { root } = fixture(); git(root, 'remote', 'add', 'github', github);
+  expect(strategy.evaluateHighWater(await measure(root, policy)).ok).toBe(true);
+  git(root, 'remote', 'add', 'foreign', 'git@github.com:example/another.git');
+  expect(strategy.evaluateHighWater(await measure(root, policy)).ok).toBe(false);
+});
+test('a push URL distinct from the fetch URL cannot inherit its tracking evidence', async () => {
+  const { root } = fixture(); git(root, 'remote', 'set-url', '--push', 'origin', 'git@github.com:example/another.git');
+  expect(strategy.evaluateHighWater(await measure(root, policy)).ok).toBe(false);
+});
+test('staged assets are sized without changing the real index', async () => {
+  const { root } = fixture();
+  writeFileSync(join(root, 'new-art.bin'), randomBytes(200 * 1024)); git(root, 'add', '--', 'new-art.bin');
+  // Staged commits reserve both pack framing and prospective metadata.
+  const stagedPolicy = { ...policy, providerLimits: { github: { bytes: 192 * 1024 } } };
+  const index = readFileSync(join(root, '.git/index'));
+  expect(strategy.evaluateHighWater(await measure(root, stagedPolicy, { includeStaged: true })).ok).toBe(false);
+  expect(readFileSync(join(root, '.git/index')).equals(index)).toBe(true);
+  git(root, 'rm', '--cached', '--', 'new-art.bin');
+  writeFileSync(join(root, 'README.md'), 'small staged edit\n'); git(root, 'add', '--', 'README.md');
+  expect(strategy.evaluateHighWater(await measure(root, stagedPolicy, { includeStaged: true })).ok).toBe(true);
+});
+test('each provider limit is compared to its own outgoing set', async () => {
+  const { root } = fixture();
+  const bigger = { ...policy, providerLimits: { github: { bytes: 1024 * 1024 }, gitlab: { bytes: 128 * 1024 } } };
+  git(root, 'remote', 'add', 'gitlab', gitlab);
+  git(root, 'update-ref', 'refs/remotes/gitlab/main', git(root, 'rev-parse', 'HEAD'));
+  git(root, 'update-ref', '-d', 'refs/remotes/origin/main');
+  expect(strategy.evaluateHighWater(await measure(root, bigger)).ok).toBe(true);
+});
+
+test('a lagging or new mirror cannot block a small local commit, but publication stays guarded', async () => {
+  const { root } = fixture(); git(root, 'remote', 'add', 'gitlab', gitlab);
+  const localPolicy = { ...policy, providerLimits: { github: { bytes: 192 * 1024 }, gitlab: { bytes: 192 * 1024 } } };
+  writeFileSync(join(root, 'README.md'), 'pending small update\n'); git(root, 'add', '--', 'README.md');
+  expect(strategy.evaluateHighWater(await strategy.measureCommitPreparation(root, localPolicy)).ok).toBe(true);
+  expect(strategy.evaluateHighWater(await measure(root, localPolicy)).ok).toBe(false);
+  writeFileSync(join(root, 'too-large.bin'), randomBytes(200 * 1024)); git(root, 'add', '--', 'too-large.bin');
+  expect(strategy.evaluateHighWater(await strategy.measureCommitPreparation(root, localPolicy)).ok).toBe(false);
+});
+
+
+test('a pinned OID push checks only its actual destination despite other mirror backlogs', async () => {
+  const { root, base } = fixture();
+  const head = git(root, 'rev-parse', 'HEAD');
+  git(root, 'remote', 'add', 'github', github);
+  git(root, 'remote', 'add', 'gitlab', gitlab);
+  git(root, 'remote', 'add', 'unrecognized', 'ssh://example.invalid/unclassified.git');
+  const refs = [{ localRef: head, localOid: head, remoteRef: 'refs/heads/main', remoteTip: base }];
+  const result = await measure(root, policy, { refs, targetRemoteName: 'origin', targetRemoteUrl: github });
+  expect(strategy.evaluateHighWater(result).ok).toBe(true);
+  expect(result.scenarios.map(s => s.remote)).toEqual(['origin']);
+  expect(result.projectedBytes).toBeLessThan(128 * 1024);
+  const newTarget = await measure(root, policy, {
+    refs: [{ ...refs[0], remoteTip: '0'.repeat(40) }], targetRemoteName: 'gitlab', targetRemoteUrl: gitlab
+  });
+  expect(strategy.evaluateHighWater(newTarget).ok).toBe(false);
+  expect(newTarget.scenarios.map(s => s.remote)).toEqual(['gitlab']);
+  expect(newTarget.projectedBytes).toBeGreaterThan(256 * 1024);
+});
